{
  "manifest_version": 3,
  "name": "Character Chatbot - local AI reply assistant",
  "version": "0.7.1",
  "description": "AI character reply assistant: consent-gated suggestions aur per-chat auto-replies. Apni Groq (ya OpenAI-compatible) API key se, ya hosted backend se. Telegram/WhatsApp adapters experimental.",
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "contextMenus"
  ],
  "host_permissions": [
    "http://127.0.0.1:8787/*",
    "http://localhost:8787/*",
    "https://*.onrender.com/*",
    "https://api.groq.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options/options.html",
  "content_scripts": [
    {
      "matches": [
        "https://web.telegram.org/*"
      ],
      "js": [
        "content/engine.js",
        "content/adapters/telegram.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "content/engine.js",
        "content/adapters/whatsapp.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Character Chatbot: is site par apni chat select karo"
  },
  "optional_host_permissions": [
    "https://*/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ]
}