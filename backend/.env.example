# AI provider settings (OpenAI-compatible API)
# Provider/cost abhi final nahi hai - jo bhi use karo, pehle uska free tier/pricing verify kar lena.
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=yahan_apni_key_dalo
AI_MODEL=llama-3.3-70b-versatile

# Server port (extension ke manifest/options mein bhi yahi hona chahiye)
PORT=8787

# Test mode: bina API key ke fake reply. Asli AI ke liye hatao ya false rakho.
AI_MOCK=true

# Shared secret: koi aur website/app tumhare local backend ko call na kar sake.
# Yahan jo likho, wahi extension Options > Auth token mein likho. Set karna recommended hai.
AUTH_TOKEN=
