# AI provider settings (OpenAI-compatible API)
# Provider/cost abhi final nahi hai - jo bhi use karo, pehle uska free tier/pricing verify kar lena.
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=yahan_apni_key_dalo
AI_MODEL=openai/gpt-oss-120b

# (Optional) Reasoning models par reasoning depth. Groq gpt-oss ke liye 'low'
# fast+cheap rakhta hai. Doosre providers isko ignore/bhi reject kar sakte hain.
# AI_REASONING_EFFORT=low

# Server port (extension ke manifest/options mein bhi yahi hona chahiye)
PORT=8787

# Test mode: bina API key ke fake reply. Asli AI ke liye hatao ya false rakho.
AI_MOCK=true

# Shared secret: koi aur website/app tumhare local backend ko call na kar sake.
# Yahan jo likho, wahi extension Options > Auth token mein likho. Set karna recommended hai.
AUTH_TOKEN=

# (Optional) Per-contact memory in MongoDB. Set karne par /reply exchanges
# ownerId+chatId ke saath store hote hain (har contact ki alag memory).
# KHAALI chhodne par memory poori tarah off rehti hai.
# IMPORTANT: is project ka APNA dedicated free Atlas cluster banao - kisi doosre
# project ka cluster reuse mat karo. (Abhi koi cluster create nahi kiya gaya.)
MONGODB_URI=

# Memory ke liye zaroori: token -> ownerId mapping (JSON). ownerId sirf token se
# derive hota hai, client se nahi - taaki koi caller doosre owner ka data na chhue.
# Example: OWNER_TOKENS={"mera-secret-token":"lakshya"}
OWNER_TOKENS=
